# Copy to .env (never commit .env). Without any key the engine runs in offline mode:
# rule-based extraction, statistics-based GraphRAG answers and template hypotheses.

# Primary LLM provider (Claude) - extraction, GraphRAG synthesis, hypothesis generation and judging.
ANTHROPIC_API_KEY=
# KE_ANTHROPIC_MODEL=claude-opus-5-5

# Optional alternative provider, used only if ANTHROPIC_API_KEY is empty.
OPENAI_API_KEY=
# KE_OPENAI_MODEL=gpt-4o-mini

# Optional: force a provider ("offline" disables LLM calls) or a search backend ("chroma" | "lsa").
# KE_LLM_PROVIDER=
# KE_SEARCH_BACKEND=
# Contact email for the OpenAlex / Crossref polite pool when harvesting literature.
# KE_CONTACT_EMAIL=
